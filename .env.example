# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase.
# Encontre em: supabase.com/dashboard > seu projeto > Settings > API Keys
#
# A chave aqui é a PÚBLICA — ela vai para o bundle do app e isso é o esperado.
# Quem protege seus dados é o RLS (supabase/03_rls.sql), não o segredo da chave.
# NUNCA coloque a chave "secret" / "service_role" aqui: ela ignora o RLS.
#
# Dependendo da idade do projeto, a chave pública aparece com um destes nomes:
#   - Publishable key  → começa com  sb_publishable_...   (projetos novos)
#   - anon public      → começa com  eyJhbGciOi...        (projetos antigos)
# As duas funcionam igual neste app. Use a que o seu painel mostrar.

VITE_SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
